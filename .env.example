# WhatsApp Cloud API
WHATSAPP_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=a_random_string_you_choose

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Access control — only your number can use the bot (E.164 format, e.g. 12125551234)
ALLOWED_SENDER=your_phone_number

# Search backend: "google" or "searxng"
SEARCH_BACKEND=google

# Google Custom Search (only needed if SEARCH_BACKEND=google)
GOOGLE_CSE_KEY=your_google_api_key
GOOGLE_CSE_CX=your_custom_search_engine_id

# SearXNG (only needed if SEARCH_BACKEND=searxng)
SEARXNG_URL=http://searxng:8080

# Cache settings
CACHE_DB_PATH=air_reader_cache.db
CACHE_TTL_SECONDS=86400
